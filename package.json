{
  "name": "oid4vc-ts",
  "private": true,
  "description": "Environment agnostic TypeScript implementation of OpenID4VC specifications",
  "packageManager": "pnpm@10.18.3+sha512.bbd16e6d7286fd7e01f6b3c0b3c932cda2965c06a908328f74663f10a9aea51f1129eea615134bf992831b009eabe167ecb7008b597f40ff9bc75946aadfb08d",
  "repository": {
    "url": "https://github.com/openwallet-foundation-labs/oid4vc-ts",
    "type": "git"
  },
  "author": "Animo Solutions",
  "license": "Apache-2.0",
  "scripts": {
    "types:check": "tsc --noEmit",
    "style:check": "biome check --unsafe",
    "style:fix": "biome check --write --unsafe",
    "build": "pnpm -r build",
    "test": "vitest",
    "release": "pnpm build && pnpm changeset publish-script --no-git-tag 2>&1 | tee changeset-publish.log",
    "changeset-version": "pnpm changeset version-script && pnpm style:fix"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@changesets/cli": "^3.0.0",
    "@openid4vc/oauth2": "workspace:*",
    "@openid4vc/openid4vp": "workspace:*",
    "@openid4vc/utils": "workspace:*",
    "@types/node": "^26.1.1",
    "jose": "catalog:",
    "msw": "^2.15.0",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.19"
  }
}
